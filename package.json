{
  "name": "launch-radar",
  "version": "1.0.0",
  "private": true,
  "description": "LaunchRadar – Raketenstarts live verfolgen (Flightradar-Stil)",
  "scripts": {
    "build": "node scripts/bundle.js && node scripts/py.js scripts/build.py && node scripts/py.js scripts/og_launch.py && node scripts/seo_pages.js",
    "watch": "node scripts/bundle.js --watch",
    "fetch": "bash scripts/fetch_data.sh",
    "world": "node scripts/make_world.js",
    "serve": "node scripts/py.js -m http.server 8000 --directory dist",
    "test": "node scripts/smoke.js"
  },
  "dependencies": {
    "d3-array": "^3.2.5",
    "d3-geo": "^3.1.2",
    "leaflet": "1.9.4",
    "satellite.js": "5.0.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "playwright-core": "1.56"
  }
}
